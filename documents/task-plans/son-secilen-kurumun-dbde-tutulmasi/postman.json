				{
					"name": "S0 — Landing Aktif Kurum Listesi (Public Summary)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
									"",
									"const res = pm.response.json();",
									"pm.test(\"AYS Response formatı başarılı\", () => {",
									"    pm.expect(res.isSuccess).to.be.true;",
