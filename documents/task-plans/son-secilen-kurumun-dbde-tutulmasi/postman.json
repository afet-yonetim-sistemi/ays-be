						},
						"url": {
							"raw": "{{base_url}}/api/institution/v1/users",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"institution",
								"v1",
								"users"
							]
						},
						"description": "Kullanıcı listesi sorgulanır. AysIdentity.getInstitutionId() ile seçili kuruma ait kayıtların filtrelendiği doğrulanır."
					},
					"response": []
				},
				{
