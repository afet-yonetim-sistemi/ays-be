				{
					"name": "S3 — Token Yenileme (Refresh Token) İle Kurum Bağlamının Korunması",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
									"",
									"const res = pm.response.json();",
									"pm.test(\"Yeni access token üretildi\", () => {",
									"    pm.expect(res.isSuccess).to.be.true;",
									"    pm.expect(res.response.accessToken).to.be.a(\"string\").that.is.not.empty;",
									"    pm.collectionVariables.set(\"accessToken\", res.response.accessToken);",
									"});",
									"",
									"function parseJwt(token) {",
									"    var base64Url = token.split('.')[1];",
									"    var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
									"    var jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {",
									"        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
									"    }).join(''));",
									"    return JSON.parse(jsonPayload);",
									"}",
									"",
									"pm.test(\"Yenilenen token'da kurum ID'si korundu\", () => {",
									"    const claims = parseJwt(res.response.accessToken);",
									"    pm.expect(claims.institutionId).to.eql(pm.collectionVariables.get(\"currentInstitutionId\"));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/authentication/token/refresh",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"authentication",
								"token",
								"refresh"
							]
						},
						"description": "Refresh token ile yeni access token alınır. Kurum bağlamının korunduğu doğrulanır."
					},
					"response": []
				},
				{
					"name": "S4 — Veri Kapsamının (Data Scoping) Seçili Kuruma Göre Filtrelenmesi",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
