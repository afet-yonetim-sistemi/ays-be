									"    pm.expect(list[0]).to.have.property(\"id\");",
									"    pm.expect(list[0]).to.have.property(\"name\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/landing/v1/institutions/summary",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"landing",
								"v1",
								"institutions",
								"summary"
							]
						},
						"description": "Landing ekranında herkese açık aktif kurum özet listesini çeker. Auth gerekmez."
					},
					"response": []
				},
				{
					"name": "S1 — Yeni Test Kullanıcısı İle Login & Kurumun JWT Claims'e Yüklenmesi",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Status 200 OK\", () => pm.response.to.have.status(200));",
									"",
									"const res = pm.response.json();",
									"pm.test(\"isSuccess true ve token'lar döndü\", () => {",
									"    pm.expect(res.isSuccess).to.be.true;",
									"    pm.expect(res.response.accessToken).to.be.a(\"string\").that.is.not.empty;",
									"    pm.expect(res.response.refreshToken).to.be.a(\"string\").that.is.not.empty;",
									"    pm.collectionVariables.set(\"accessToken\", res.response.accessToken);",
									"    pm.collectionVariables.set(\"refreshToken\", res.response.refreshToken);",
									"});",
									"",
									"function parseJwt(token) {",
									"    var base64Url = token.split('.')[1];",
									"    var base64 = base64Url.replace(/-/g, '+').replace(/_/g, '/');",
									"    var jsonPayload = decodeURIComponent(atob(base64).split('').map(function(c) {",
									"        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);",
									"    }).join(''));",
									"    return JSON.parse(jsonPayload);",
									"}",
									"",
									"pm.test(\"JWT Claims: DB'deki son seçili kurum (institutionId) yüklendi\", () => {",
									"    const claims = parseJwt(res.response.accessToken);",
									"    pm.expect(claims.institutionId).to.be.a(\"string\").that.is.not.empty;",
									"    pm.expect(claims.institutionName).to.be.a(\"string\").that.is.not.empty;",
									"    pm.expect(claims.institutions).to.be.an(\"array\").that.is.not.empty;",
									"    pm.collectionVariables.set(\"currentInstitutionId\", claims.institutionId);",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"emailAddress\": \"{{emailAddress}}\",\n  \"password\": \"{{password}}\",\n  \"sourcePage\": \"{{sourcePage}}\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/v1/authentication/token",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"api",
								"v1",
								"authentication",
								"token"
							]
						},
						"description": "Yeni oluşturulan test kullanıcısı ile login olur. AysResponse<AysTokenResponse> döner. Token içindeki institutionId claims'i doğrulanır."
					},
					"response": []
				},
